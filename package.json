{
  "name": "youtube-transcript-mcp",
  "type": "module",
  "version": "0.1.0",
  "description": "MCP server that extracts YouTube video transcripts",
  "license": "MIT",
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "claude"
  ],
  "main": "dist/index.js",
  "bin": {
    "youtube-transcript-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:register": "bash scripts/register.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
